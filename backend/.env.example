# Bắt buộc (config.Load() sẽ lỗi nếu thiếu)
# Với docker compose trong repo: cổng host thường là 5433 (xem infra/compose/docker-compose.yml)
DATABASE_URL=postgres://knowmarket:knowmarket@localhost:5433/knowmarket?sslmode=disable
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai

# SIWE (EIP-4361) — bắt buộc; phải khớp frontend (wagmi / siwe)
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3000
# Base=8453, Arbitrum=42161, Anvil thường=31337
SIWE_CHAIN_ID=8453
# Tuỳ chọn: dòng statement trong message; để trống = không kiểm tra
# SIWE_STATEMENT=Sign in to KnowMarket

# Tùy chọn (có default trong code)
HTTP_ADDR=:8080
AUTH_NONCE_TTL_MINUTES=5
AUTH_JWT_TTL_DAYS=7
