# Go API (same host/port as backend HTTP_ADDR). No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Must match backend SIWE_CHAIN_ID (default 8453 = Base mainnet; 31337 = local Hardhat/Anvil)
NEXT_PUBLIC_SIWE_CHAIN_ID=8453

# Public origin of this Next app (must match backend SIWE_URI for SIWE)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

